# Copy to .env and fill in the values you actually have.
# .env is gitignored. config.toml is also gitignored and overrides nothing
# that you set here: environment variables win over config.toml at startup.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
# Numeric Telegram ids allowed to run /storage. Empty uses the allowlist above.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_RATE_LIMIT_PER_HOUR=5
TELEGRAM_PUBLIC_BASE_URL=
PUBLIC_BASE_URL=
WEB_PASSWORD=
MEDIA_TOKEN_SECRET=
TELEGRAM_SERVICE_SECRET=

# Inside docker-compose the bot reaches the API by service name.
# MPT_API_BASE_URL=http://api:8080

# --- API auth ---
# When set, /api/v1 and /tasks require the x-api-key header.
API_KEY=

# --- Script writer ---
# An OpenAI-compatible relay: set these three and leave LLM_PROVIDER empty.
# LLM_PROVIDER=openai still works, and these fill any OpenAI fields you left blank.
# Do not put a vendor host in the image. Point LLM_BASE_URL at your relay.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Stock footage (at least one when video_source is pexels or pixabay) ---
VIDEO_SOURCE=pexels
PEXELS_API_KEYS=
PIXABAY_API_KEYS=

# --- Local tools ---
FFMPEG_PATH=
IMAGEMAGICK_PATH=
TASK_RETENTION_HOURS=24
MAX_CONCURRENT_TASKS=1
# Clip cache budget and a hard cap for storage/, in megabytes.
MATERIAL_CACHE_MAX_MB=512
STORAGE_CAP_MB=2048
# true deletes a video after Telegram delivery and a fully successful publish.
DELETE_AFTER_DELIVERY=false
# true renders 720p with one encode thread. The Docker stack defaults this to true.
MPT_LOW_MEMORY=false
# Rotating application log. Docker also caps container logs.
# MPT_LOG_FILE=/MoneyPrinterTurbo/storage/logs/server.log

# --- YouTube Data API (OAuth client from Google Cloud) ---
# Redirect URI must be exactly PUBLIC_BASE_URL + /auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Default quota allows about 6 uploads per project per day.
YOUTUBE_DAILY_UPLOAD_QUOTA=6
# Optional extra Cloud projects, comma-separated slugs.
# YOUTUBE_PROJECTS=studio-b
# YOUTUBE_STUDIO_B_CLIENT_ID=
# YOUTUBE_STUDIO_B_CLIENT_SECRET=
# YOUTUBE_STUDIO_B_DAILY_UPLOAD_QUOTA=6

# --- TikTok Content Posting API (Login Kit) ---
# Redirect URI must be exactly PUBLIC_BASE_URL + /auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# false until TikTok audits the app. Direct posts are private (SELF_ONLY).
TIKTOK_AUDITED=false
# direct or inbox
TIKTOK_POST_MODE=direct
TIKTOK_DAILY_POSTS_PER_ACCOUNT=15

# Seconds between the start of each account's publish job. 0 sends them together.
PUBLISH_STAGGER_SECONDS=20
PUBLISH_MAX_CONCURRENT_JOBS=1
# Ask the language model for a different caption per account.
PUBLISH_VARY_COPY=false

# --- Oracle / Cloudflare ---
# Named tunnel token from Cloudflare Zero Trust. Leave empty to skip cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=
# GHCR image. Empty builds moneyprinterturbo:local on the server.
# MPT_IMAGE=ghcr.io/YOUR_GITHUB_USER/YOUR_REPO:main
MPT_API_MEM_LIMIT=1536m
MPT_API_CPUS=1.0
MPT_API_PIDS_LIMIT=256
MPT_WEBUI_MEM_LIMIT=512m
MPT_WEBUI_CPUS=0.5
MPT_BOT_MEM_LIMIT=256m
MPT_BOT_CPUS=0.25
MPT_LOG_MAX_SIZE=10m
MPT_LOG_MAX_FILE=3

