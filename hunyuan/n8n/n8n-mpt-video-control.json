    {
      "id": "ef60b9ce-0d53-4dc2-81b3-6ee5bad55b9d",
      "name": "Kaggle: Fetch Selftest Result",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        560,
        450
      ],
      "parameters": {
        "command": "cd /data/yt-scripts/gpu/kaggle && rm -rf /tmp/mpt_selftest && python3 kaggle_launch.py fetch --mode selftest -o /tmp/mpt_selftest; cat /tmp/mpt_selftest/*.json 2>/dev/null; rm -rf /tmp/mpt_selftest 2>&1 | tail -n 40"
      },
      "onError": "continueRegularOutput"
