      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'));\nconst req = $('POST mpt-clips/status').first().json.body || {};\nif (m.job_id !== req.job_id) throw new Error('manifest job_id mismatch');\nreturn [{ json: { status: 'done', job_id: m.job_id, gpu_backend: m.gpu_backend || '', sources: m.gpu_sources || {},\n  clips: (m.clips || []).map(c => ({ name: c.name, file_id: c.file_id })) } }];"
      }
