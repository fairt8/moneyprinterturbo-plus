    {
      "id": "c0c21d2a-fd12-4ca6-a3a6-84d2680bc3b1",
      "name": "Kaggle: Selftest (only if idle)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        560,
        300
      ],
      "parameters": {
        "command": "cd /data/yt-scripts/gpu/kaggle && S=$(python3 kaggle_launch.py status --mode drive); echo \"$S\"; if echo \"$S\" | grep -Eq '\"state\": \"(running|queued)\"'; then echo 'BUSY: the batch kernel is running, try again when it finishes'; else KAGGLE_VIDEO_MODEL=\"${MPT_SELFTEST_MODEL:-hy15-i2v}\" KAGGLE_PARALLEL=1 python3 kaggle_launch.py ensure --mode selftest; fi 2>&1 | tail -n 40"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "57bda072-16a5-4001-9239-09482c31066c",
