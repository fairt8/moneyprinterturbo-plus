# /opt/ytauto/scripts/gpu/kaggle/secrets/gpu.env  on the n8n server (owner root, group 1000, mode 640)
# NEVER commit the real file. Already created by YouTube Auto: only fill the Kaggle lines.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=paste_key_or_KGAT_token_here
GPU_BRIDGE_PUBLIC_URL=https://YOUR-N8N-HOST/webhook/gpu-bridge
GPU_BRIDGE_TOKEN=same_value_as_the_n8n_credential_GPU_Bridge_Token
KAGGLE_VIDEO_MODEL=wan21-diffusers      # kernel default; MoneyPrinter jobs choose their own model per job
KAGGLE_PARALLEL=2                       # set 1 if HunyuanVideo jobs run out of RAM
KAGGLE_MAX_HOURS=11
KAGGLE_MIN_QUOTA_H=1
# HunyuanVideo-1.5 tuning (only used by hy15-* jobs)
HY15_STEPS=8
HY15_MAX_FRAMES=61
HY15_DTYPE=fp16                          # set bf16 if clips come out black
