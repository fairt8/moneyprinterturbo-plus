      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        560,
        0
      ],
      "parameters": {
        "command": "cd /data/yt-scripts/gpu/kaggle && echo QUOTA; python3 kaggle_launch.py quota; echo BATCH_KERNEL; python3 kaggle_launch.py status --mode drive; echo SELFTEST_KERNEL; python3 kaggle_launch.py status --mode selftest 2>&1 | tail -n 40"
