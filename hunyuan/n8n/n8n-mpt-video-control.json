    {
      "id": "78da0a7f-a7a8-428c-aacb-3525ef2a52ce",
      "name": "Build Test Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Video App Control Form').first().json;\nconst prompt = String(f['Test prompt'] || 'A golden coin spinning slowly on a dark wooden desk, soft rim light, cinematic, vertical framing').slice(0, 1500);\nconst model = ['wan21-diffusers', 'ltx-t2v', 'wan22-5b-diffusers', 'hy15-t2v'].includes(f['Model']) ? f['Model'] : 'wan21-diffusers';\nconst ts = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 12);\nconst job_id = `mpt_manual_${ts}_${Math.random().toString(36).slice(2, 6)}`;\nconst now = Date.now();\nconst job = { job_id, channel: 'moneyprinter', format: 'mpt_clips', source: 'manual-form', topic: 'manual test', title: 'manual test',\n  video_model: model, video: { width: 480, height: 832 }, scenes: [{ idx: 0, narration: 'test clip', prompt, sfx: '' }],\n  status: 'pending', created_at: new Date(now).toISOString(), expires_at: new Date(now + 720 * 60000).toISOString(), cpu_fallback: false };\nreturn [{ json: { job_id, model }, binary: { data: { data: Buffer.from(JSON.stringify(job)).toString('base64'), mimeType: 'application/json', fileName: job_id + '.json' } } }];"
      }
    },
